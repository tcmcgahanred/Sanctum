        <mxCell id="mandate" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#FBEEC2;strokeColor=#B8860B;fontSize=11;align=left;spacingLeft=8;" value="Mandate&#10;standing directives + lessons log" vertex="1">
