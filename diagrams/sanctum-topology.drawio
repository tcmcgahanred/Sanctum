        <mxCell id="e10" edge="1" parent="1" source="doctrine" style="endArrow=open;html=1;dashed=1;strokeColor=#B8860B;fontSize=10;" target="arbites" value="governs"><mxGeometry relative="1" as="geometry" /></mxCell>
