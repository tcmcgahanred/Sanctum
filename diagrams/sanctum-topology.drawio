          <mxGeometry height="94" width="260" x="1140" y="450" as="geometry" />
        </mxCell>
        <mxCell id="after" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;dashed=1;fillColor=none;strokeColor=#A9A79F;fontSize=10;align=left;spacingLeft=8;fontColor=#5F5E5A;" value="Wednesday review, and whatever follows it,&#10;are deliberately OUT OF SCOPE." vertex="1">
          <mxGeometry height="50" width="260" x="1140" y="566" as="geometry" />
        </mxCell>

        <mxCell id="e1" edge="1" parent="1" source="pnd" style="endArrow=block;html=1;strokeColor=#5F5E5A;" target="acolyte"><mxGeometry relative="1" as="geometry" /></mxCell>
