        <mxCell id="e12" edge="1" parent="1" source="git" style="endArrow=block;html=1;dashed=1;strokeColor=#534AB7;fontSize=10;" target="host" value="pull only"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="cogitator" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#F1EFE8;strokeColor=#5F5E5A;fontSize=11;align=left;spacingLeft=8;" value="Cogitator — the intel-cycle map&#10;Plan → Collect → Process → Analyse → Disseminate → Feedback" vertex="1">
          <mxGeometry height="62" width="470" x="40" y="510" as="geometry" />
        </mxCell>
        <mxCell id="git" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;align=left;spacingLeft=8;" value="Git repo (public)&#10;source of truth: engines + doctrine + domains" vertex="1">
          <mxGeometry height="58" width="300" x="1120" y="640" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="text;html=1;align=left;fontSize=11;fontColor=#5F5E5A;whiteSpace=wrap;" value="The engines hold no domain knowledge — a new domain is one pnd.md. Synthesis stays manual by choice, not limitation (tenet 7). The corpus is permanent and grows, so archive search gets more useful every week.&#10;&#10;THE OPEN GAP: stage 4 is the least portable part of the apparatus. Clone the repo and you get collection and triage — but not the method that turns 55 candidates into a vox." vertex="1">
          <mxGeometry height="110" width="1040" x="40" y="600" as="geometry" />
        </mxCell>

      </root>
