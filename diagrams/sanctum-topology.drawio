        <mxCell id="pnd" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#F1EFE8;strokeColor=#888780;fontSize=11;align=left;spacingLeft=8;" value="&lt;domain&gt;/pnd.md&#10;the single control surface:&#10;sensors · scoring · production" vertex="1">
          <mxGeometry height="70" width="152" x="66" y="252" as="geometry" />
        </mxCell>
        <mxCell id="acolyte" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=11;align=left;spacingLeft=8;" value="Acolyte&#10;collect · extract · dedupe" vertex="1">
