        <mxCell id="doctrine" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;dashed=1;fillColor=#FCF3D9;strokeColor=#B8860B;verticalAlign=top;fontStyle=1;fontSize=12;align=center;spacingTop=4;" value="Doctrine — governs scoring and analysis alike" vertex="1">
