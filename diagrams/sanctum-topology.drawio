        <mxCell id="title" parent="1" style="text;html=1;align=left;fontStyle=1;fontSize=15;" value="Sanctum — Apparatus Architecture (CTI effort)" vertex="1">
          <mxGeometry height="26" width="700" x="40" y="14" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;fontSize=11;fontColor=#5F5E5A;" value="Stage 3 makes the STAGING DOCUMENT. Stage 4 makes the VOX. Two artifacts, two owners — that boundary is the point of this diagram." vertex="1">
          <mxGeometry height="20" width="980" x="40" y="44" as="geometry" />
        </mxCell>

        <mxCell id="band1" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;dashed=1;fillColor=#FBFAF7;strokeColor=#A9A79F;verticalAlign=top;fontStyle=1;fontSize=10;align=center;spacingTop=3;fontColor=#5F5E5A;" value="1 · PLANNING &amp; DIRECTION" vertex="1">
          <mxGeometry height="120" width="180" x="52" y="222" as="geometry" />
        </mxCell>
        <mxCell id="band2" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=6;dashed=1;fillColor=#FBFAF7;strokeColor=#A9A79F;verticalAlign=top;fontStyle=1;fontSize=10;align=center;spacingTop=3;fontColor=#5F5E5A;" value="2 · COLLECTION" vertex="1">
