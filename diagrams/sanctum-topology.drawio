          <mxGeometry height="70" width="168" x="640" y="252" as="geometry" />
        </mxCell>
        <mxCell id="staging" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E6F1FB;strokeColor=#185FA5;fontStyle=1;fontSize=11;align=left;spacingLeft=8;" value="STAGING DOCUMENT&#10;~55 ranked candidates, each&#10;showing its reasoning&#10;+ mandatory drop list" vertex="1">
          <mxGeometry height="70" width="180" x="828" y="252" as="geometry" />
        </mxCell>

        <mxCell id="lexicanum" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#E1F5EE;strokeColor=#0F6E56;fontSize=11;align=left;spacingLeft=8;" value="Lexicanum — asked on demand, outside the weekly cycle&#10;searches the WHOLE archive by keyword group · counts matches per period as a RATE&#10;matches recomputed live, so a group invented today runs against everything ever collected" vertex="1">
          <mxGeometry height="66" width="572" x="256" y="372" as="geometry" />
        </mxCell>

        <mxCell id="drive" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=10;fillColor=#EEEDFE;strokeColor=#534AB7;fontSize=11;align=left;spacingLeft=8;" value="Corpus store (Google Drive today — swappable)&#10;carries the corpus AND the dated staging document" vertex="1">
          <mxGeometry height="62" width="330" x="620" y="510" as="geometry" />
        </mxCell>

        <mxCell id="synth" parent="1" style="whiteSpace=wrap;html=1;rounded=1;arcSize=8;fillColor=#FAECE7;strokeColor=#D85A30;fontSize=11;align=left;spacingLeft=8;" value="Human gate + LLM chat&#10;reads the STAGING DOCUMENT&#10;— not the corpus&#10;&#10;selects · writes into prose&#10;judges relevance · assigns sections&#10;flags what is unverified&#10;&#10;⚠ this method is not yet in the repo" vertex="1">
          <mxGeometry height="176" width="260" x="1140" y="258" as="geometry" />
        </mxCell>
